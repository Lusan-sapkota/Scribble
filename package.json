{
  "name": "scribble",
  "private": true,
  "version": "0.1.1",
  "description": "Mark up the web. Hand-drawn notes, arrows and diagrams that stay pinned to the page and are there when you come back.",
  "license": "MIT",
  "author": "Lusan Sapkota",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lusan-sapkota/Scribble.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "zip": "pnpm build && cd dist && zip -qr ../scribble-v$npm_package_version.zip ."
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0-a52cd20",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
